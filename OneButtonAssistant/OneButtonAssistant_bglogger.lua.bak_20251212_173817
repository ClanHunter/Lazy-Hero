-- OneButtonAssistant BG Logger (compact, conservative)
local BGLogger = {}
BGLogger.version = "0.2"

-- Configuration defaults
local DEFAULT_MAX_EVENTS = 2000
local DEFAULT_MAX_MATCHES = 50
local DEFAULT_WHITELIST = {
  SPELL_CAST_SUCCESS = true, SPELL_DAMAGE = true, SPELL_HEAL = true,
  SPELL_AURA_APPLIED = true, SPELL_AURA_REMOVED = true, SPELL_INTERRUPT = true,
  SPELL_DISPEL = true, SPELL_STOLEN = true, PARTY_KILL = true,
  UNIT_DIED = true, UNIT_DESTROYED = true,
}
local DEFAULT_SAMPLING = 1 -- record every Nth matching event (1 = all)
local DEFAULT_LOG_POSITIONS = false -- off by default for privacy

-- Use shared helpers where available, fall back to local behavior
local shared = OneButtonAssistantShared or {}
local function safeCall(f, ...)
  if shared and shared.safeCall then return shared.safeCall(f, ...) end
  if not f then return nil end
  local ok, res = pcall(f, ...)
  if ok then return res end
  return nil
end

local function now()
  if shared and shared.now then return shared.now() end
  return (GetTime and GetTime()) or time()
end

local function ensureDB()
  if shared and shared.ensureDB then return shared.ensureDB() end
  OneButtonAssistantDB = OneButtonAssistantDB or {}
  OneButtonAssistantDB.bgLogs = OneButtonAssistantDB.bgLogs or {}
  OneButtonAssistantDB.bgConfig = OneButtonAssistantDB.bgConfig or {}
  if OneButtonAssistantDB.bgConfig.maxEvents == nil then OneButtonAssistantDB.bgConfig.maxEvents = DEFAULT_MAX_EVENTS end
  if OneButtonAssistantDB.bgConfig.maxMatches == nil then OneButtonAssistantDB.bgConfig.maxMatches = DEFAULT_MAX_MATCHES end
  if not OneButtonAssistantDB.bgSalt then OneButtonAssistantDB.bgSalt = tostring(math.random(1, 1e9)) end
end

local function guidHash(guid)
  if shared and shared.guidHash then return shared.guidHash(guid) end
  if not guid then return "-" end
  ensureDB()
  local s = tostring(guid) .. (OneButtonAssistantDB.bgSalt or "")
  local h = 5381
  for i = 1, #s do
    h = (h * 33 + string.byte(s, i)) % 1000000007
  end
  return tostring(h)
end

local state = {
  recording = false,
  current = nil,
}

-- apply config overrides from saved variables
local function loadConfig()
  ensureDB()
  OneButtonAssistantDB.bgConfig = OneButtonAssistantDB.bgConfig or {}
  OneButtonAssistantDB.bgConfig.whitelist = OneButtonAssistantDB.bgConfig.whitelist or DEFAULT_WHITELIST
  OneButtonAssistantDB.bgConfig.maxEvents = OneButtonAssistantDB.bgConfig.maxEvents or DEFAULT_MAX_EVENTS
  OneButtonAssistantDB.bgConfig.maxMatches = OneButtonAssistantDB.bgConfig.maxMatches or DEFAULT_MAX_MATCHES
  OneButtonAssistantDB.bgConfig.sampling = OneButtonAssistantDB.bgConfig.sampling or DEFAULT_SAMPLING
  if OneButtonAssistantDB.bgConfig.logPositions == nil then OneButtonAssistantDB.bgConfig.logPositions = DEFAULT_LOG_POSITIONS end
end
loadConfig()

local function startMatch(zone)
  ensureDB()
  if state.recording then return end
  local id = tostring(math.floor(now())) .. "-" .. (zone or "unknown") .. "-" .. tostring(math.random(1000,9999))
  state.current = {
    meta = {
      matchID = id,
      zone = zone or (safeCall(GetZoneText) or "unknown"),
      startTime = now(),
      endTime = nil,
      events = 0,
      truncated = false,
      player = {},      -- populated below (metadata for the local player)
      team = {},        -- optional team composition summary (class/spec counts)
    },
    stats = {          -- aggregated performance counters for quick analytics
      damageDone = 0,
      healingDone = 0,
      damageTaken = 0,
      kills = 0,
      deaths = 0,
      assists = 0,
      interruptsByPlayer = 0,
      interruptsOnPlayer = 0,
      dispelsByPlayer = 0,
      dispelsOnPlayer = 0,
      auraAppliedByPlayer = 0,
      auraAppliedToPlayer = 0,
      objectives = {},
    },
    events = {},
  }
  -- try to populate common player metadata
  pcall(function()
    local name = safeCall(UnitName, "player")
    local _, class = safeCall(UnitClass, "player")
    local race = safeCall(UnitRace, "player")
    local level = safeCall(UnitLevel, "player")
    local faction = safeCall(UnitFactionGroup) or "unknown"
    local guid = safeCall(UnitGUID, "player")
    state.current.meta.player = {
      name = name or "player",
      class = class or "UNKNOWN",
      race = race or "UNKNOWN",
      level = level or 0,
      faction = faction,
      guid = guid and guidHash(guid) or "-",
    }
    -- attempt to collect a simple team composition summary
    local members = safeCall(GetNumGroupMembers) or 0
    if members and members > 0 then
      local comp = {}
      for i = 1, members do
        local unit = (IsInRaid and IsInRaid()) and ("raid"..i) or ("party"..i)
        local n, c = safeCall(UnitName, unit), safeCall(UnitClass, unit)
        if c then comp[c] = (comp[c] or 0) + 1 end
      end
      state.current.meta.team = comp
    end
  end)
  state.recording = true
end

local function endMatch()
  ensureDB()
  if not state.recording or not state.current then return end
  state.current.meta.endTime = now()
  -- append to saved db, keep bounded size
  OneButtonAssistantDB.bgLogs = OneButtonAssistantDB.bgLogs or {}
  table.insert(OneButtonAssistantDB.bgLogs, state.current)
  -- cap matches
  while #OneButtonAssistantDB.bgLogs > (OneButtonAssistantDB.bgConfig.maxMatches or DEFAULT_MAX_MATCHES) do
    table.remove(OneButtonAssistantDB.bgLogs, 1)
  end
  state.current = nil
  state.recording = false
end

local function recordEvent(ev)
  ensureDB()
  if not state.recording or not state.current then return end
  local cfgMax = OneButtonAssistantDB.bgConfig.maxEvents or DEFAULT_MAX_EVENTS
  if state.current.meta.events >= cfgMax then state.current.meta.truncated = true; return end
  table.insert(state.current.events, ev)
  state.current.meta.events = state.current.meta.events + 1
end

-- handle combat log events conservatively
local function OnCombatLogEvent()
  if not state.recording then return end
  local args = { CombatLogGetCurrentEventInfo() }
  if not args or #args < 2 then return end
  local timestamp = args[1]
  local subevent = args[2]
  if not timestamp or not subevent then return end
  -- respect whitelist in saved config (allow runtime tuning)
  ensureDB()
  local wl = (OneButtonAssistantDB and OneButtonAssistantDB.bgConfig and OneButtonAssistantDB.bgConfig.whitelist) or DEFAULT_WHITELIST
  if not wl[subevent] then return end
  -- sampling: only record roughly every Nth matching event to reduce volume
  local sampling = (OneButtonAssistantDB and OneButtonAssistantDB.bgConfig and tonumber(OneButtonAssistantDB.bgConfig.sampling)) or DEFAULT_SAMPLING
  state._counter = (state._counter or 0) + 1
  if sampling and sampling > 1 and (state._counter % sampling) ~= 0 then return end

  local srcGUID = args[4]
  local dstGUID = args[8]
  local src = guidHash(srcGUID)
  local dst = guidHash(dstGUID)
  local info = { t = timestamp, e = subevent, src = src, dst = dst }
  -- parse common extras: spellId (12), spellName (13), amount (varies)
  local spellId = args[12]
  local spellName = args[13]
  if spellId and type(spellId) == 'number' then info.s = spellId end
  if spellName and type(spellName) == 'string' then info.sn = spellName end
  -- amount detection: look for first numeric after spellName
  for i = 14, #args do
    if type(args[i]) == 'number' then
      info.amt = args[i]
      break
    end
  end

  -- optionally record location for the local player when privacy opt-in is enabled
  pcall(function()
    ensureDB()
    if OneButtonAssistantDB and OneButtonAssistantDB.bgConfig and OneButtonAssistantDB.bgConfig.logPositions then
      local ok, mapID = pcall(function() if C_Map and C_Map.GetBestMapForUnit then return C_Map.GetBestMapForUnit("player") end end)
      if ok and mapID and C_Map and C_Map.GetPlayerMapPosition then
        local ok2, vec = pcall(function() return C_Map.GetPlayerMapPosition(mapID, "player") end)
        if ok2 and vec and vec.x and vec.y then
          info.pos = { m = mapID, x = tonumber(string.format("%.4f", vec.x)), y = tonumber(string.format("%.4f", vec.y)) }
        end
      else
        -- fallback to UnitPosition for rough coordinates (map-agnostic)
        local ok3, ux, uy, uz = pcall(function() return UnitPosition("player") end)
        if ok3 and ux and uy then info.pos = { x = tonumber(string.format("%.4f", ux)), y = tonumber(string.format("%.4f", uy)), z = tonumber(string.format("%.2f", uz or 0)) } end
      end
    end
  end)

  -- update aggregated stats
  local stats = state.current and state.current.stats
  local playerHash = state.current and state.current.meta and state.current.meta.player and state.current.meta.player.guid
  if stats then
    -- damage events
    if subevent:find("DAMAGE") or subevent == "SWING_DAMAGE" or subevent == "RANGE_DAMAGE" then
      local amt = tonumber(info.amt) or 0
      if src == playerHash then stats.damageDone = stats.damageDone + amt end
      if dst == playerHash then stats.damageTaken = stats.damageTaken + amt end
    end
    -- healing
    if subevent:find("HEAL") then
      local amt = tonumber(info.amt) or 0
      if src == playerHash then stats.healingDone = stats.healingDone + amt end
    end
    -- interrupts
    if subevent == "SPELL_INTERRUPT" then
      if src == playerHash then stats.interruptsByPlayer = stats.interruptsByPlayer + 1 end
      if dst == playerHash then stats.interruptsOnPlayer = stats.interruptsOnPlayer + 1 end
    end
    -- dispels / stolen
    if subevent == "SPELL_DISPEL" or subevent == "SPELL_STOLEN" then
      if src == playerHash then stats.dispelsByPlayer = stats.dispelsByPlayer + 1 end
      if dst == playerHash then stats.dispelsOnPlayer = stats.dispelsOnPlayer + 1 end
    end
    -- auras applied/removed (proxy for CC counts)
    if subevent == "SPELL_AURA_APPLIED" then
      if src == playerHash then stats.auraAppliedByPlayer = stats.auraAppliedByPlayer + 1 end
      if dst == playerHash then stats.auraAppliedToPlayer = stats.auraAppliedToPlayer + 1 end
    end
    -- kills/deaths
    if subevent == "PARTY_KILL" then
      if src == playerHash then stats.kills = stats.kills + 1 end
    end
    if subevent == "UNIT_DIED" then
      if dst == playerHash then stats.deaths = stats.deaths + 1 end
    end
  end

  -- keep compact event stored
  recordEvent(info)
end

-- Build NDJSON (newline-delimited JSON) string for a match (compact)
local function matchToNDJSON(match)
  if shared and shared.matchToNDJSON then return shared.matchToNDJSON(match) end
  if not match then return nil end
  local lines = {}
  local function esc(s)
    if shared and shared.escape_for_json then return shared.escape_for_json(s) end
    if s == nil then return "" end
    return tostring(s):gsub('\\','\\\\'):gsub('"','\\"')
  end
  -- meta line with player and stats embedded
  local m = match.meta or {}
  local p = m.player or {}
  local s = match.stats or {}
  local metaParts = {}
  table.insert(metaParts, '"matchID":"'..esc(m.matchID)..'"')
  table.insert(metaParts, '"zone":"'..esc(m.zone)..'"')
  table.insert(metaParts, '"startTime":'..tostring(m.startTime or 0))
  table.insert(metaParts, '"endTime":'..tostring(m.endTime or 0))
  table.insert(metaParts, '"events":'..tostring(m.events or 0))
  table.insert(metaParts, '"truncated":'..tostring(m.truncated and true or false))
  -- player subobject
  local playerParts = {}
  if p.name then table.insert(playerParts, '"name":"'..esc(p.name)..'"') end
  if p.class then table.insert(playerParts, '"class":"'..esc(p.class)..'"') end
  if p.race then table.insert(playerParts, '"race":"'..esc(p.race)..'"') end
  if p.level then table.insert(playerParts, '"level":'..tostring(p.level)) end
  if p.faction then table.insert(playerParts, '"faction":"'..esc(p.faction)..'"') end
  if p.guid then table.insert(playerParts, '"guid":"'..esc(p.guid)..'"') end
  table.insert(metaParts, '"player":{'..table.concat(playerParts, ',')..'}')
  -- stats subobject (shallow)
  local statsParts = {}
  local sp = s
  table.insert(statsParts, '"damageDone":'..tostring(sp.damageDone or 0))
  table.insert(statsParts, '"healingDone":'..tostring(sp.healingDone or 0))
  table.insert(statsParts, '"damageTaken":'..tostring(sp.damageTaken or 0))
  table.insert(statsParts, '"kills":'..tostring(sp.kills or 0))
  table.insert(statsParts, '"deaths":'..tostring(sp.deaths or 0))
  table.insert(statsParts, '"interruptsByPlayer":'..tostring(sp.interruptsByPlayer or 0))
  table.insert(statsParts, '"interruptsOnPlayer":'..tostring(sp.interruptsOnPlayer or 0))
  table.insert(statsParts, '"dispelsByPlayer":'..tostring(sp.dispelsByPlayer or 0))
  table.insert(statsParts, '"dispelsOnPlayer":'..tostring(sp.dispelsOnPlayer or 0))
  table.insert(statsParts, '"auraAppliedByPlayer":'..tostring(sp.auraAppliedByPlayer or 0))
  table.insert(statsParts, '"auraAppliedToPlayer":'..tostring(sp.auraAppliedToPlayer or 0))
  table.insert(metaParts, '"stats":{'..table.concat(statsParts, ',')..'}')

  table.insert(lines, '{"meta":{'..table.concat(metaParts, ',')..'}}')

  -- per-event lines
  for _, e in ipairs(match.events or {}) do
    local line = nil
    if shared and shared.format_event_line then
      line = shared.format_event_line(e)
    else
      local parts = {}
      if e.t then table.insert(parts, '"t":'..tostring(e.t)) end
      if e.e then table.insert(parts, '"e":"'..esc(e.e)..'"') end
      if e.s then table.insert(parts, '"s":'..tostring(e.s)) end
      if e.sn then table.insert(parts, '"sn":"'..esc(e.sn)..'"') end
      if e.amt then table.insert(parts, '"amt":'..tostring(e.amt)) end
      if e.src then table.insert(parts, '"src":"'..esc(e.src)..'"') end
      if e.dst then table.insert(parts, '"dst":"'..esc(e.dst)..'"') end
      line = '{' .. table.concat(parts, ',') .. '}'
    end
    if line then table.insert(lines, line) end
  end
  return table.concat(lines, "\n")
end

-- Prepare NDJSON export for a match and write to OneButtonAssistantDB.bgExport (string). Chunking can be added later.
function BGLogger.PrepareExport(matchID)
  if shared and shared.prepare_export then
    return shared.prepare_export(matchID)
  end
  ensureDB()
  for _, m in ipairs(OneButtonAssistantDB.bgLogs or {}) do
    if m.meta and m.meta.matchID == matchID then
      local nd = matchToNDJSON(m)
      OneButtonAssistantDB.bgExport = OneButtonAssistantDB.bgExport or {}
      OneButtonAssistantDB.bgExport[matchID] = nd
      return nd
    end
  end
  return nil
end

-- Prepare chunked NDJSON export: split a match export into multiple chunks (by lines)
function BGLogger.PrepareExportChunks(matchID, linesPerChunk)
  if shared and shared.prepare_export_chunks then
    return shared.prepare_export_chunks(matchID, linesPerChunk)
  end
  ensureDB()
  linesPerChunk = tonumber(linesPerChunk) or 500
  for _, m in ipairs(OneButtonAssistantDB.bgLogs or {}) do
    if m.meta and m.meta.matchID == matchID then
      local nd = matchToNDJSON(m)
      if not nd then return nil end
      local chunks = nil
      if shared and shared.chunk_ndjson then
        chunks = shared.chunk_ndjson(nd, linesPerChunk)
      else
        local parts = {}
        for line in nd:gmatch("([^\n]+)\n?") do table.insert(parts, line) end
        chunks = {}
        local i = 1
        while i <= #parts do
          local j = math.min(i + linesPerChunk - 1, #parts)
          local seg = table.concat(parts, "\n", i, j)
          table.insert(chunks, seg)
          i = j + 1
        end
      end
      OneButtonAssistantDB.bgExportChunks = OneButtonAssistantDB.bgExportChunks or {}
      OneButtonAssistantDB.bgExportChunks[matchID] = chunks
      OneButtonAssistantDB.bgExport = OneButtonAssistantDB.bgExport or {}
      OneButtonAssistantDB.bgExport[matchID] = nil -- clear single big export when using chunks
      -- manifest for convenience
      OneButtonAssistantDB.bgExportManifest = OneButtonAssistantDB.bgExportManifest or {}
      OneButtonAssistantDB.bgExportManifest[matchID] = { chunks = #chunks, linesPerChunk = linesPerChunk }
      return chunks
    end
  end
  return nil
end

-- Prepare chunked exports for all saved matches
function BGLogger.PrepareAllChunks(linesPerChunk)
  if shared and shared.prepare_all_chunks then
    return shared.prepare_all_chunks(linesPerChunk)
  end
  ensureDB()
  local results = {}
  for _, m in ipairs(OneButtonAssistantDB.bgLogs or {}) do
    local id = m.meta and m.meta.matchID
    if id then
      local chunks = BGLogger.PrepareExportChunks(id, linesPerChunk)
      results[id] = chunks and #chunks or 0
    end
  end
  return results
end

-- Runtime API: toggle position logging and show exports in a copy-friendly UI
function BGLogger.EnablePositionLogging(enable)
  ensureDB()
  OneButtonAssistantDB.bgConfig = OneButtonAssistantDB.bgConfig or {}
  OneButtonAssistantDB.bgConfig.logPositions = enable and true or false
  return OneButtonAssistantDB.bgConfig.logPositions
end

function BGLogger.IsPositionLoggingEnabled()
  ensureDB()
  return OneButtonAssistantDB.bgConfig and OneButtonAssistantDB.bgConfig.logPositions
end

function BGLogger.ShowExportUI(matchID, chunkIndex)
  ensureDB()
  local text = nil
  if OneButtonAssistantDB.bgExportChunks and OneButtonAssistantDB.bgExportChunks[matchID] then
    local chunks = OneButtonAssistantDB.bgExportChunks[matchID]
    local idx = tonumber(chunkIndex) or 1
    idx = math.max(1, math.min(#chunks, idx))
    text = chunks[idx]
  elseif OneButtonAssistantDB.bgExport and OneButtonAssistantDB.bgExport[matchID] then
    text = OneButtonAssistantDB.bgExport[matchID]
  end
  if not text then return false end
  -- create a simple frame with scrollable EditBox for copying
  if not BGLogger._exportFrame then
    local f = CreateFrame("Frame", "OneButtonAssistantBGExportUI", UIParent, "BasicFrameTemplateWithInset")
    f:SetSize(700, 420)
    f:SetPoint("CENTER", UIParent, "CENTER", 0, 0)
    f.title = f:CreateFontString(nil, "OVERLAY", "GameFontHighlight")
    f.title:SetPoint("TOPLEFT", 16, -8)
    f.title:SetText("OneButtonAssistant - BG Export (copy from the box below)")
    f.scroll = CreateFrame("ScrollFrame", nil, f, "UIPanelScrollFrameTemplate")
    f.scroll:SetPoint("TOPLEFT", 12, -32)
    f.scroll:SetPoint("BOTTOMRIGHT", -36, 38)
    local eb = CreateFrame("EditBox", nil, f.scroll)
    eb:SetMultiLine(true)
    eb:EnableMouse(true)
    eb:SetAutoFocus(false)
    eb:SetFontObject(GameFontHighlightSmall)
    eb:SetWidth(640)
    eb:SetHeight(340)
    eb:SetScript("OnEscapePressed", function(self) f:Hide() end)
    f.scroll:SetScrollChild(eb)
    f.editBox = eb
    BGLogger._exportFrame = f
  end
  BGLogger._exportFrame.editBox:SetText(text)
  BGLogger._exportFrame:Show()
  return true
end

-- Event frame
local f = CreateFrame("Frame", "OneButtonAssistantBGLoggerFrame")
f:RegisterEvent("PLAYER_ENTERING_WORLD")
f:RegisterEvent("ZONE_CHANGED_NEW_AREA")
f:RegisterEvent("PLAYER_LEAVING_WORLD")
f:SetScript("OnEvent", function(self, event, ...)
  if event == "PLAYER_ENTERING_WORLD" or event == "ZONE_CHANGED_NEW_AREA" then
    -- detect battleground instance type
    local inInstance, instanceType = safeCall(IsInInstance)
    if inInstance and instanceType == "pvp" then
      startMatch(safeCall(GetZoneText) or "pvp")
    else
      -- if leaving a match, flush
      if state.recording then endMatch() end
    end
  elseif event == "PLAYER_LEAVING_WORLD" then
    if state.recording then endMatch() end
  end
end)

-- Combat log hook
f:RegisterEvent("COMBAT_LOG_EVENT_UNFILTERED")
f:SetScript("OnEvent", function(self, event, ...)
  if event == "COMBAT_LOG_EVENT_UNFILTERED" then
    pcall(OnCombatLogEvent)
  else
    -- handled above in other handler if needed
  end
end)

-- Public API
function BGLogger.Start()
  ensureDB()
  if state.recording then return false end
  startMatch(safeCall(GetZoneText) or "manual")
  return true
end

function BGLogger.Stop()
  if not state.recording then return false end
  endMatch()
  return true
end

function BGLogger.Clear()
  ensureDB()
  OneButtonAssistantDB.bgLogs = {}
  return true
end

function BGLogger.GetAll()
  ensureDB()
  return OneButtonAssistantDB.bgLogs or {}
end

function BGLogger.Export(matchID)
  ensureDB()
  if not matchID then return nil end
  -- return the full match table AND prepare a NDJSON string in OneButtonAssistantDB.bgExport[matchID]
  for _, m in ipairs(OneButtonAssistantDB.bgLogs or {}) do
    if m.meta and m.meta.matchID == matchID then
      local ok, nd = pcall(BGLogger.PrepareExport, BGLogger, matchID)
      if ok then
        return m
      else
        return m
      end
    end
  end
  return nil
end

OneButtonAssistantBGLogger = BGLogger

-- Register as adapter if core present
if OneButtonAssistant and type(OneButtonAssistant.RegisterAdapter) == "function" then
  pcall(OneButtonAssistant.RegisterAdapter, OneButtonAssistant, "bglogger", BGLogger)
end

return BGLogger
